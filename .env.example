# Public origin for metadata, sitemap, JSON-LD, OpenAPI, and llms.txt.
# The domain is not final. Replace this before launch.
NEXT_PUBLIC_SITE_URL=https://quantum-group.example

# Shared secret for agent calls. Send it as the header X-Quantum-Agent-Key.
# Leave this empty until you are ready to issue a key.
# Never commit a real value. This file is an example only.
AGENT_API_KEY=

# Invoice payments. Leave false until receiving addresses, a sanctions webhook,
# and a Reown project id are ready. The public site never holds keys or funds.
PAYMENTS_ENABLED=false

# Replace every YOUR_ value with a real receiving address before enabling payments.
# Invoice and tip profiles must use different addresses.
PAY_QUANTUM_BASE_ADDRESS=0xYOUR_QUANTUM_BASE_ADDRESS
PAY_QUANTUM_ETHEREUM_ADDRESS=0xYOUR_QUANTUM_ETHEREUM_ADDRESS
PAY_QUANTUM_SOLANA_ADDRESS=YOUR_QUANTUM_SOLANA_ADDRESS
PAY_TIP_BASE_ADDRESS=0xYOUR_TIP_BASE_ADDRESS
PAY_TIP_ETHEREUM_ADDRESS=0xYOUR_TIP_ETHEREUM_ADDRESS
PAY_TIP_SOLANA_ADDRESS=YOUR_TIP_SOLANA_ADDRESS

# Public Reown project id. Empty hides wallet connection. QR and copied addresses still work.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional HTTPS endpoint. POST a payment and return { "allowed": true|false, "reason": "..." }.
# Empty means no list is queried.
SANCTIONS_WEBHOOK_URL=

# Optional Solana RPC. Defaults to the public mainnet endpoint.
PAY_SOLANA_RPC_URL=

# Set true to show [PLACEHOLDER] and [CONFIRM] notes in a production build.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# Set false to hide the VIVID Industrial & Decor product-line name.
SHOW_VIVID_PRODUCT_LINES=

# Unpublished until true.
ROBOTICS_ENABLED=false
