# Public origin for metadata, sitemap, JSON-LD, OpenAPI, and llms.txt.
# The domain is not final. Replace this before launch.
NEXT_PUBLIC_SITE_URL=https://quantum-group.example

# Shared secret for agent calls. Send it as the header X-Quantum-Agent-Key.
# Leave this empty until you are ready to issue a key.
# Never commit a real value. This file is an example only.
AGENT_API_KEY=

# Master switch. Leave false until Antigua counsel signs off and the addresses are real.
# Unset uses the config fallback, which is also false. The site never holds keys or funds.
PAYMENTS_ENABLED=false

# Quantum profile (this site). Replace every YOUR_ value with a real public receiving address.
# PAY_BASE_ADDRESS, PAY_ETHEREUM_ADDRESS, and PAY_SOLANA_ADDRESS are aliases for this profile only.
PAY_QUANTUM_BUSINESS_NAME=Quantum Group Co
PAY_QUANTUM_BASE_ADDRESS=0xYOUR_BASE_ADDRESS
PAY_QUANTUM_ETHEREUM_ADDRESS=0xYOUR_ETHEREUM_ADDRESS
PAY_QUANTUM_SOLANA_ADDRESS=YOUR_SOLANA_ADDRESS
PAY_BASE_ADDRESS=0xYOUR_BASE_ADDRESS
PAY_ETHEREUM_ADDRESS=0xYOUR_ETHEREUM_ADDRESS
PAY_SOLANA_ADDRESS=YOUR_SOLANA_ADDRESS

# Other profile. Its own addresses. Never copy the quantum addresses here.
PAY_BOT_BUSINESS_NAME=Bot Site
PAY_BOT_BASE_ADDRESS=0xYOUR_BOT_BASE_ADDRESS
PAY_BOT_ETHEREUM_ADDRESS=0xYOUR_BOT_ETHEREUM_ADDRESS
PAY_BOT_SOLANA_ADDRESS=YOUR_BOT_SOLANA_ADDRESS

# Tips above this USD amount need a name and email. Default 1000 when unset.
ANONYMOUS_TIP_CAP_USD=1000

# Public Reown project id. Leave unset. Wallet connection hides, and QR plus address still work.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Hosted card checkout. Leave false. Links only, never a secret key.
# Stripe must be an https://buy.stripe.com payment link.
# Coinbase Commerce must be an https://commerce.coinbase.com hosted checkout.
PAY_FIAT_ENABLED=false
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_COINBASE_COMMERCE_URL=

# Optional chain-analytics hook. Both unset. The server POSTs { "address", "chain" }.
# { "allowed": false } or { "blocked": true } refuses the payment. Do not commit a key.
SANCTIONS_API_URL=
SANCTIONS_API_KEY=

# Optional HTTPS URL. The log route forwards a confirmed payment here.
# Unset means the server console only. Do not commit a secret.
PAYMENT_LOG_WEBHOOK_URL=

# Optional Solana RPC. Defaults to the public mainnet endpoint.
PAY_SOLANA_RPC_URL=

# Set true to show [PLACEHOLDER] and [CONFIRM] notes in a production build.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# Set false to hide the VIVID Industrial & Decor product-line name.
SHOW_VIVID_PRODUCT_LINES=

# Unpublished until true.
ROBOTICS_ENABLED=false

# Concept photographs. Off keeps neutral plates. On shows captioned concept renders.
DRAFT_CONTENT=false

# Off for launch. Hides the future figure, its line, and its API field.
AI_FEATURES_ENABLED=false

# Off for launch. /llms.txt, /api/openapi.json, /api, and /api/auth/agent return 404.
AGENT_API_ENABLED=false
